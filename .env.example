# ─── Supabase (required) ──────────────────────────────────────────────────────
# Find these at: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon-public-key>"
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-public-key>"
VITE_SUPABASE_PROJECT_ID="<project-id>"

# Service role key — needed for admin dashboard API routes
# KEEP SECRET — never expose to browser
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret>"

# ─── Admin dashboard ──────────────────────────────────────────────────────────
# Password to access /admin (change this to something strong)
VITE_ADMIN_PASSWORD="admin2024"

# ─── Loan form redirect ───────────────────────────────────────────────────────
# After loan submission, redirect to this URL (leave blank to show success screen)
VITE_LOAN_REDIRECT_URL=""
